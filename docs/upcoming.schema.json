{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Goes up by one with every write."
    },
    "updated_at": {
      "type": "string"
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1,
            "description": "The channel slug, for example clock-out-early."
          },
          "episode_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique per channel: <slug>-<year>-<nnnn>."
          },
          "working_title": {
            "type": "string",
            "minLength": 1
          },
          "premise": {
            "default": "",
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idea",
              "scripted",
              "queued",
              "rendering",
              "needs-review",
              "dropped"
            ]
          },
          "source_bot": {
            "type": "string",
            "minLength": 1,
            "description": "Who the idea came from: a bot name or josh."
          },
          "created_by": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string"
          },
          "updated_by": {
            "type": "string",
            "minLength": 1
          },
          "updated_at": {
            "type": "string"
          },
          "entry_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "script_path": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "drop_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "conflict": {
            "type": "boolean"
          },
          "conflict_detail": {
            "type": "string"
          }
        },
        "required": [
          "channel",
          "episode_id",
          "working_title",
          "status",
          "source_bot",
          "created_by",
          "created_at",
          "updated_by",
          "updated_at",
          "entry_revision"
        ],
        "additionalProperties": {},
        "description": "One planned episode."
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "episodes"
  ],
  "additionalProperties": {},
  "description": "The shared list of episodes in flight. Unknown fields are kept when ELO writes.",
  "title": "ELO upcoming episodes",
  "$id": "https://expectlessmedia.com/schemas/upcoming-1.0.json"
}
